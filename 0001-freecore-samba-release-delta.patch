-struct tevent_req *tn_audit_pread_send(
-	struct vfs_handle_struct *handle, TALLOC_CTX *mem_ctx,
-	struct tevent_context *ev, struct files_struct *fsp,
-	void *data, size_t n, off_t offset)
-{
