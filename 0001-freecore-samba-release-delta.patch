-		/* Extract action string */
-		if (!PyUnicode_Check(action_obj)) {
-			Py_DECREF(item);
-			PyErr_SetString(PyExc_TypeError, "action must be a string");
-			goto cleanup;
-		}
-		action_str = PyUnicode_AsUTF8(action_obj);
-		if (action_str == NULL) {
-			Py_DECREF(item);
-			goto cleanup;
-		}
