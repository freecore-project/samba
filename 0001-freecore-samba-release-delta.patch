-int py_ctdb_db_synchronize(py_ctdb_db_ctx *pydb, const char *tdb_path, int tdb_flags,
-			   int open_flags, mode_t mode)
-{
-	int err;
-	pyctdb_error_t pyerr;
-	TDB_CONTEXT *tctx;
-	uint32_t leader = _Py_atomic_load_uint32(&cluster_leader);
