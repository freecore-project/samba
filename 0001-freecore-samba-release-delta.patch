-msgid ""
-msgstr ""
-"Project-Id-Version: \n"
-"Report-Msgid-Bugs-To: samba@packages.debian.org\n"
-"POT-Creation-Date: 2017-07-17 16:42+0200\n"
-"PO-Revision-Date: 2013-10-24 23:05+0200\n"
