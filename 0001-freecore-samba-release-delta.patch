+#include "includes.h"
+#include "lib/truenas_mount.h"
+
+#include <sys/param.h>
+#include <sys/ucred.h>
+#include <sys/mount.h>
+#include <sys/stat.h>
+
+#ifdef HAVE_LIBZFS
+#ifdef FREEBSD_LIBZFS
+/*
+ * FB15: base /usr/include/sys/nvpair.h needs several Solaris-origin
+ * types that user-space headers do not define (boolean_t is
+ * _KERNEL-guarded in <sys/types.h>). Same guarded shim as
+ * smb_libzfs.c.
+ */
+#if !defined(uint_t) && !defined(_SMB_LIBZFS_UINT_T_DEFINED)
+typedef unsigned int uint_t;
+#define _SMB_LIBZFS_UINT_T_DEFINED
+#endif
+#if !defined(uchar_t) && !defined(_SMB_LIBZFS_UCHAR_T_DEFINED)
+typedef unsigned char uchar_t;
+#define _SMB_LIBZFS_UCHAR_T_DEFINED
+#endif
+#ifndef _SMB_LIBZFS_HRTIME_T_DEFINED
+typedef long long hrtime_t;
+#define _SMB_LIBZFS_HRTIME_T_DEFINED
+#endif
+#ifndef _SMB_LIBZFS_BOOLEAN_T_DEFINED
+typedef enum { B_FALSE, B_TRUE } boolean_t;
+#define _SMB_LIBZFS_BOOLEAN_T_DEFINED
+#endif
+#if !defined(ulong_t) && !defined(_SMB_LIBZFS_ULONG_T_DEFINED)
+typedef unsigned long ulong_t;
+#define _SMB_LIBZFS_ULONG_T_DEFINED
+#endif
+#include <sys/nvpair.h>
+#include <libzfs.h>
+#else
+#include <libzfs/sys/nvpair.h>
+#include <libzfs/libzfs.h>
+#endif /* FREEBSD_LIBZFS */
+#endif /* HAVE_LIBZFS */
+
+/*
+ * FreeBSD has no statmount(2)/listmount(2) and no 64-bit unique mount
+ * IDs. Here a mount ID is the device ID of the mount root: every FreeBSD
+ * mount -- each mounted ZFS dataset included -- has a distinct st_dev,
+ * and every file's st_dev equals its mount's, which is what lets
+ * init_stat_ex_from_bsd_stat() populate st_ex_mnt_id without extra
+ * syscalls. Unlike Linux unique mount IDs these are only stable while
+ * the mount exists; an unmount may allow reuse. There is also no kernel
+ * parent-mount linkage, so parents are derived from mountpoint paths:
+ * the parent of a mount is the mount with the longest mountpoint that
+ * is a proper path prefix of its mountpoint. The root mount is its own
+ * parent.
+ */
+
+/* Field-validity bits, mirroring the Linux STATMOUNT_* uapi values. */
+#ifndef STATMOUNT_SB_BASIC
+#define STATMOUNT_SB_BASIC	0x00000001U
+#endif
+#ifndef STATMOUNT_MNT_BASIC
+#define STATMOUNT_MNT_BASIC	0x00000002U
+#endif
+#ifndef STATMOUNT_MNT_ROOT
+#define STATMOUNT_MNT_ROOT	0x00000008U
+#endif
+#ifndef STATMOUNT_MNT_POINT
+#define STATMOUNT_MNT_POINT	0x00000010U
+#endif
+#ifndef STATMOUNT_FS_TYPE
+#define STATMOUNT_FS_TYPE	0x00000020U
+#endif
+#ifndef STATMOUNT_MNT_OPTS
+#define STATMOUNT_MNT_OPTS	0x00000080U
+#endif
+#ifndef STATMOUNT_SB_SOURCE
+#define STATMOUNT_SB_SOURCE	0x00000200U
+#endif
+
+#define TN_MOUNT_MASK (STATMOUNT_SB_BASIC | STATMOUNT_MNT_BASIC | \
+		       STATMOUNT_MNT_ROOT | STATMOUNT_MNT_POINT | \
+		       STATMOUNT_FS_TYPE | STATMOUNT_MNT_OPTS | \
+		       STATMOUNT_SB_SOURCE)
+
+struct tn_mount_table {
+	size_t count;
+	struct tn_mount_entry *entries;
+};
+
+#ifdef HAVE_LIBZFS
+/*
+ * ZFS on FreeBSD does not expose casesensitivity as a mount option,
+ * but smb_libzfs derives a dataset's case mode from the mnt_opts
+ * tokens (casesensitive/caseinsensitive/casemixed), so synthesize the
+ * token from the dataset property (the internal development record). A failed lookup leaves
+ * the token out, which consumers treat as unknown.
+ */
+static const char *fbsd_zfs_case_token(libzfs_handle_t **hdl,
+				       const char *source)
+{
+	zfs_handle_t *zhp = NULL;
+	char buf[64];
+	int rc;
+
+	if (*hdl == NULL) {
+		*hdl = libzfs_init();
+		if (*hdl == NULL) {
+			return NULL;
+		}
+		libzfs_print_on_error(*hdl, B_FALSE);
+	}
+
+	zhp = zfs_open(*hdl, source,
+		       ZFS_TYPE_FILESYSTEM | ZFS_TYPE_SNAPSHOT);
+	if (zhp == NULL) {
+		return NULL;
+	}
+	rc = zfs_prop_get(zhp, ZFS_PROP_CASE, buf, sizeof(buf),
+			  NULL, NULL, 0, B_FALSE);
+	zfs_close(zhp);
+	if (rc != 0) {
+		return NULL;
+	}
+
+	if (strcmp(buf, "sensitive") == 0) {
+		return "casesensitive";
+	}
+	if (strcmp(buf, "insensitive") == 0) {
+		return "caseinsensitive";
+	}
+	if (strcmp(buf, "mixed") == 0) {
+		return "casemixed";
+	}
+	return NULL;
+}
+#endif /* HAVE_LIBZFS */
+
+/*
+ * mnt_opts as tn_mount_has_opt() sees it. Per the API contract the
+ * ro/rw state is deliberately not included -- see tn_mount_is_readonly().
+ */
+static char *fbsd_opts_string(TALLOC_CTX *mem_ctx, uint64_t f_flags)
+{
+	static const struct {
+		uint64_t flag;
+		const char *name;
+	} tokens[] = {
+		{ MNT_NOATIME,		"noatime" },
+		{ MNT_NOSUID,		"nosuid" },
+		{ MNT_NOEXEC,		"noexec" },
+		{ MNT_NFS4ACLS,		"nfsv4acls" },
+		{ MNT_ACLS,		"acls" },
+		{ MNT_AUTOMOUNTED,	"automounted" },
+		{ MNT_UNION,		"union" },
+	};
+	char *opts = talloc_strdup(mem_ctx, "");
+	size_t i;
+
+	if (opts == NULL) {
+		return NULL;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(tokens); i++) {
+		if ((f_flags & tokens[i].flag) == 0) {
+			continue;
+		}
+		opts = talloc_asprintf_append_buffer(
+			opts, "%s%s", (*opts != '\0') ? "," : "",
+			tokens[i].name);
+		if (opts == NULL) {
+			return NULL;
+		}
+	}
+	return opts;
+}
+
+static bool is_path_descendant(const char *mnt_point, const char *ancestor)
+{
+	size_t alen = strlen(ancestor);
+
+	if (strcmp(ancestor, "/") == 0) {
+		return (strcmp(mnt_point, "/") != 0);
+	}
+	if (strncmp(mnt_point, ancestor, alen) != 0) {
+		return false;
+	}
+	return (mnt_point[alen] == '/');
+}
+
+/*
+ * Snapshot the mount table. Mounts whose mountpoint cannot be stat'ed
+ * (for example a ZFS snapshot automount expiring between enumeration
+ * and lookup) are skipped silently, matching the Linux implementation.
+ */
+static struct tn_mount_table *tn_mount_table_get(TALLOC_CTX *mem_ctx)
+{
+	struct tn_mount_table *table = NULL;
+	struct statfs *mounts = NULL;
+	int cnt;
+	int i;
+#ifdef HAVE_LIBZFS
+	libzfs_handle_t *zfs_hdl = NULL;
+#endif
+
+	table = talloc_zero(mem_ctx, struct tn_mount_table);
+	if (table == NULL) {
+		errno = ENOMEM;
+		return NULL;
+	}
+
+	/*
+	 * getmntinfo() keeps the buffer in libc-internal storage that a
+	 * later call replaces; everything needed is copied out below.
+	 * MNT_NOWAIT avoids blocking on unresponsive filesystems for
+	 * statfs refreshes.
+	 */
+	cnt = getmntinfo(&mounts, MNT_NOWAIT);
+	if (cnt <= 0) {
+		DBG_ERR("getmntinfo() failed: %s\n", strerror(errno));
+		TALLOC_FREE(table);
+		return NULL;
+	}
+
+	table->entries = talloc_zero_array(table, struct tn_mount_entry,
+					   cnt);
+	if (table->entries == NULL) {
+		TALLOC_FREE(table);
+		errno = ENOMEM;
+		return NULL;
+	}
+
+	for (i = 0; i < cnt; i++) {
+		struct tn_mount_entry *entry =
+			&table->entries[table->count];
+		struct stat st;
+
+		if (stat(mounts[i].f_mntonname, &st) != 0) {
+			continue;
+		}
+
+		entry->mnt_id = (uint64_t)st.st_dev;
+		entry->mnt_parent_id = entry->mnt_id;
+		entry->mnt_id_old = (uint32_t)st.st_dev;
+		entry->mnt_attr = 0;
+		entry->sb_dev = st.st_dev;
+		entry->sb_magic = 0;
+		entry->sb_flags = (uint32_t)mounts[i].f_flags;
+		entry->mask = TN_MOUNT_MASK;
+
+		entry->fs_type = talloc_strdup(table->entries,
+					       mounts[i].f_fstypename);
+		entry->mnt_root = talloc_strdup(table->entries, "/");
+		entry->mnt_point = talloc_strdup(table->entries,
+						 mounts[i].f_mntonname);
+		entry->sb_source = talloc_strdup(table->entries,
+						 mounts[i].f_mntfromname);
+		entry->mnt_opts = fbsd_opts_string(table->entries,
+						   mounts[i].f_flags);
+		if ((entry->fs_type == NULL) || (entry->mnt_root == NULL) ||
+		    (entry->mnt_point == NULL) ||
+		    (entry->sb_source == NULL) || (entry->mnt_opts == NULL)) {
+#ifdef HAVE_LIBZFS
+			if (zfs_hdl != NULL) {
+				libzfs_fini(zfs_hdl);
+			}
+#endif
+			TALLOC_FREE(table);
+			errno = ENOMEM;
+			return NULL;
+		}
+
+#ifdef HAVE_LIBZFS
+		if (strcmp(entry->fs_type, "zfs") == 0) {
+			const char *tok = fbsd_zfs_case_token(
+				&zfs_hdl, entry->sb_source);
+			if (tok != NULL) {
+				entry->mnt_opts =
+					talloc_asprintf_append_buffer(
+						entry->mnt_opts, "%s%s",
+						(*entry->mnt_opts != '\0') ?
+							"," : "",
+						tok);
+				if (entry->mnt_opts == NULL) {
+					if (zfs_hdl != NULL) {
+						libzfs_fini(zfs_hdl);
+					}
+					TALLOC_FREE(table);
+					errno = ENOMEM;
+					return NULL;
+				}
+			}
+		}
+#endif /* HAVE_LIBZFS */
+
+		table->count++;
+	}
+#ifdef HAVE_LIBZFS
+	if (zfs_hdl != NULL) {
+		libzfs_fini(zfs_hdl);
+	}
+#endif
+
+	/*
+	 * Parent linkage by longest proper mountpoint prefix. Stacked
+	 * mounts over the same directory cannot be ordered by path; the
+	 * consumers of mnt_parent_id fall back to a namespace-wide scan
+	 * when the parent is not what they expect, so imprecision here
+	 * degrades to a slower lookup, never a wrong result.
+	 */
+	for (i = 0; (size_t)i < table->count; i++) {
+		struct tn_mount_entry *entry = &table->entries[i];
+		size_t best_len = 0;
+		size_t j;
+
+		for (j = 0; j < table->count; j++) {
+			const struct tn_mount_entry *cand =
+				&table->entries[j];
+			size_t clen;
+
+			if (j == (size_t)i) {
+				continue;
+			}
+			if (!is_path_descendant(entry->mnt_point,
+						cand->mnt_point)) {
+				continue;
+			}
+			clen = strlen(cand->mnt_point);
+			if (clen >= best_len) {
+				best_len = clen;
+				entry->mnt_parent_id = cand->mnt_id;
+			}
+		}
+	}
+
+	return table;
+}
+
+static struct tn_mount_entry *table_find_id(const struct tn_mount_table *table,
+					    uint64_t mnt_id)
+{
+	size_t i;
+
+	for (i = 0; i < table->count; i++) {
+		if (table->entries[i].mnt_id == mnt_id) {
+			return &table->entries[i];
+		}
+	}
+	return NULL;
+}
+
+int tn_mount_entry_get(TALLOC_CTX *mem_ctx,
+		       uint64_t mnt_id,
+		       struct tn_mount_entry **entry_out)
+{
+	struct tn_mount_table *table = NULL;
+	struct tn_mount_entry *found = NULL;
+	struct tn_mount_entry *out = NULL;
+	int saved_errno;
+
+	table = tn_mount_table_get(NULL);
+	if (table == NULL) {
+		return -1;
+	}
+
+	found = table_find_id(table, mnt_id);
+	if (found == NULL) {
+		TALLOC_FREE(table);
+		errno = ENOENT;
+		return -1;
+	}
+
+	out = tn_mount_entry_copy(mem_ctx, found);
+	if (out == NULL) {
+		saved_errno = errno;
+		TALLOC_FREE(table);
+		errno = saved_errno;
+		return -1;
+	}
+	TALLOC_FREE(table);
+
+	*entry_out = out;
+	return 0;
+}
+
+int tn_mount_path_get_mnt_id(const char *path, uint64_t *mnt_id_out)
+{
+	struct stat st;
+
+	if (stat(path, &st) != 0) {
+		DBG_INFO("stat() failed for %s: %s\n", path,
+			 strerror(errno));
+		return -1;
+	}
+	*mnt_id_out = (uint64_t)st.st_dev;
+	return 0;
+}
+
+int tn_mount_entry_get_path(TALLOC_CTX *mem_ctx,
+			    const char *path,
+			    struct tn_mount_entry **entry_out)
+{
+	uint64_t mnt_id;
+	int ret;
+
+	ret = tn_mount_path_get_mnt_id(path, &mnt_id);
+	if (ret != 0) {
+		return -1;
+	}
+	return tn_mount_entry_get(mem_ctx, mnt_id, entry_out);
+}
+
+static bool copy_entry_string(struct tn_mount_entry *out,
+			      const char **dst,
+			      const char *src)
+{
+	if (src == NULL) {
+		*dst = NULL;
+		return true;
+	}
+	*dst = talloc_strdup(out, src);
+	return (*dst != NULL);
+}
+
+struct tn_mount_entry *tn_mount_entry_copy(TALLOC_CTX *mem_ctx,
+					   const struct tn_mount_entry *entry)
+{
+	struct tn_mount_entry *out = NULL;
+	bool ok;
+
+	out = talloc_zero(mem_ctx, struct tn_mount_entry);
+	if (out == NULL) {
+		errno = ENOMEM;
+		return NULL;
+	}
+	*out = *entry;
+
+	ok = copy_entry_string(out, &out->fs_type, entry->fs_type) &&
+	     copy_entry_string(out, &out->mnt_root, entry->mnt_root) &&
+	     copy_entry_string(out, &out->mnt_point, entry->mnt_point) &&
+	     copy_entry_string(out, &out->mnt_opts, entry->mnt_opts) &&
+	     copy_entry_string(out, &out->sb_source, entry->sb_source);
+	if (!ok) {
+		TALLOC_FREE(out);
+		errno = ENOMEM;
+		return NULL;
+	}
+
+	return out;
+}
+
+int tn_mount_traverse(uint64_t parent_mnt_id,
+		      bool reverse,
+		      tn_mount_traverse_fn fn,
+		      void *private_data)
+{
+	struct tn_mount_table *table = NULL;
+	const char *scope = NULL;
+	size_t i;
+
+	table = tn_mount_table_get(NULL);
+	if (table == NULL) {
+		return -1;
+	}
+
+	if (parent_mnt_id != TN_MOUNT_NS_ROOT) {
+		const struct tn_mount_entry *parent =
+			table_find_id(table, parent_mnt_id);
+
+		if (parent == NULL) {
+			TALLOC_FREE(table);
+			errno = ENOENT;
+			return -1;
+		}
+		scope = parent->mnt_point;
+	}
+
+	/*
+	 * getmntinfo() reports mounts in mount order, so most-recently-
+	 * mounted first means walking the snapshot backwards.
+	 */
+	for (i = 0; i < table->count; i++) {
+		size_t idx = reverse ? (table->count - 1 - i) : i;
+		const struct tn_mount_entry *entry = &table->entries[idx];
+		bool proceed;
+
+		if (entry->mnt_id == parent_mnt_id) {
+			continue;
+		}
+		if ((scope != NULL) &&
+		    !is_path_descendant(entry->mnt_point, scope)) {
+			continue;
+		}
+
+		proceed = fn(entry, private_data);
+		if (!proceed) {
+			break;
+		}
+	}
+
+	TALLOC_FREE(table);
+	return 0;
+}
+
+bool tn_mount_has_opt(const struct tn_mount_entry *entry, const char *opt)
+{
+	const char *p = entry->mnt_opts;
+	size_t optlen = strlen(opt);
+
+	if (p == NULL) {
+		return false;
+	}
+
+	while (*p != '\0') {
+		const char *end = strchrnul(p, ',');
+
+		if (((size_t)(end - p) == optlen) &&
+		    (memcmp(p, opt, optlen) == 0)) {
+			return true;
+		}
+		p = (*end != '\0') ? end + 1 : end;
