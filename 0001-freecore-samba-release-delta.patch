+	if (!NT_STATUS_IS_OK(status)) {
+		return status;
+	}
+
+	hdr_flags = IVAL(recv_iov[0].iov_base, SMB2_HDR_FLAGS);
+	if (!(hdr_flags & SMB2_HDR_FLAG_SIGNED)) {
+		return NT_STATUS_INVALID_NETWORK_RESPONSE;
+	}
+
+	return NT_STATUS_OK;
