+	fd = open(pid_directory, O_RDONLY | O_DIRECTORY);
+	if (fd == -1) {
+		DBG_ERR("%s: failed to open pid directory: %s\n",
+			pid_directory, strerror(errno));
+		return false;
+	}
+
+	written = snprintf(fdesc_path, sizeof(fdesc_path), pattern, fd);
+	if (written < 0 || (size_t)written >= sizeof(fdesc_path)) {
+		close(fd);
+		return false;
+	}
+
+	fd2 = open(fdesc_path, O_RDONLY | O_DIRECTORY);
+	if (fd2 == -1) {
+		/*
+		 * Without nodup, fdescfs exposes its synthetic vnode here.
+		 * O_DIRECTORY then fails instead of reopening the directory fd.
+		 */
+		if (errno == ENOTDIR) {
+			DBG_ERR("%s: fdescfs filesystem is not mounted with "
+				"'nodup' option. This mount option is required "
+				"for race-free FreeBSD pathref handling.\n",
+				fdesc_path);
+		} else {
+			DBG_ERR("%s: failed to open fdescfs path: %s\n",
+				fdesc_path, strerror(errno));
+		}
+		close(fd);
+		return false;
+	}
+
+	close(fd);
+	close(fd2);
+	return true;
+}
+
+static bool set_freebsd_proc_fd_pattern(char *buf, size_t bufsize)
+{
+	const char *pid_directory = lp_pid_directory();
+	const char *base_dirs[] = {
+		pid_directory,
+		"/dev",
+		NULL,
+	};
+	const char **base;
+	int written;
+
+	for (base = &base_dirs[0]; *base != NULL; base++) {
+		if ((*base)[0] == '\0') {
+			continue;
+		}
+
+		written = snprintf(buf, bufsize, "%s/fd/%%d", *base);
+		if (written < 0 || (size_t)written >= bufsize) {
+			continue;
+		}
+
+		/*
+		 * sys_proc_fd_path() formats into the fixed-size
+		 * struct sys_proc_fd_path_buf; a base whose worst-case
+		 * formatted path cannot fit must not be selected.
+		 */
+		if ((size_t)written + 11 >
+		    sizeof(((struct sys_proc_fd_path_buf *)0)->buf)) {
+			continue;
+		}
+
+		if (freebsd_fdesc_check(buf)) {
+			return true;
+		}
+	}
+
+	return false;
+}
+#endif
+
+static bool set_proc_fd_pattern(void)
+{
+	if (set_linux_proc_fd_pattern(proc_fd_pattern_buf,
+				      sizeof(proc_fd_pattern_buf))) {
+		proc_fd_pattern = proc_fd_pattern_buf;
+		return true;
+	}
+
+#ifdef FREEBSD
+	if (set_freebsd_proc_fd_pattern(proc_fd_pattern_buf,
+					sizeof(proc_fd_pattern_buf))) {
+		proc_fd_pattern = proc_fd_pattern_buf;
+		return true;
+	}
+#endif
+
+	return false;
+}
+
+bool sys_have_proc_fds(void)
+{
