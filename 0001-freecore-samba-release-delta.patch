-		/* Access struct sequence fields directly */
-		action_obj = PyStructSequence_GET_ITEM(item, 0);
-		key_obj = PyStructSequence_GET_ITEM(item, 1);
-		value_obj = PyStructSequence_GET_ITEM(item, 2);
