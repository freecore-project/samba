-int store_tdb_in_ctdb(struct ctdb_transaction_handle *h, TDB_CONTEXT *tctx, pyctdb_error_t *error)
-{
-	struct store_tdb_in_ctdb_state state = {.error = error, .h = h};
-	int rv;
-
-	rv = tdb_traverse(tctx, store_tdb_record, &state);
-	if (rv < 0) {
