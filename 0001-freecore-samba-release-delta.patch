+	struct ldb_dn *dn = NULL;
+	struct ldb_dn *dn2 = NULL;
+
 	if (is_untrusted == false) {
 		return LDB_SUCCESS;
 	}
 
+	switch (req->operation) {
+	case LDB_SEARCH:
+		dn = req->op.search.base;
+		break;
+	case LDB_ADD:
+		dn = req->op.add.message->dn;
+		break;
+	case LDB_MODIFY:
+		dn = req->op.mod.message->dn;
+		break;
+	case LDB_DELETE:
+		dn = req->op.del.dn;
+		break;
+	case LDB_RENAME:
+		dn = req->op.rename.olddn;
+		dn2 = req->op.rename.newdn;
