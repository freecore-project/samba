diff --git a/ctdb/common/ctdb_io.c b/ctdb/common/ctdb_io.c
index 9ac9b84a7fb2dd5930874f0ceb0892509db08fd7..346a7456f471554c16a7db60b3eb37aacd75bdc1 100644
